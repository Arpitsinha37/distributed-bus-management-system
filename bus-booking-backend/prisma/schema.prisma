generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  SUPER_ADMIN // sees and manages every site
  SITE_MANAGER // scoped to their assigned site(s)
  COUNTER_AGENT // scoped to their assigned site(s), booking-only
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

// ── Storefronts ─────────────────────────────────────────────
// One row per branded site. Adding a 4th storefront is a new row here,
// not new backend code.
model Site {
  id           String   @id @default(cuid())
  slug         String   @unique // used as the X-Site-Id sent by each frontend
  name         String
  domain       String   @unique
  logoUrl      String?
  themeColor   String?
  currency     String   @default("NPR")
  contactPhone String?
  contactEmail String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff    StaffSite[]
  bookings Booking[]
}

// ── Staff / admin panel users ───────────────────────────────
model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(COUNTER_AGENT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  sites StaffSite[]
}

// join table: which sites a staff member can operate on (empty = all, for SUPER_ADMIN)
model StaffSite {
  staffId String
  siteId  String
  staff   Staff  @relation(fields: [staffId], references: [id])
  site    Site   @relation(fields: [siteId], references: [id])

  @@id([staffId, siteId])
}

// ── Fleet ────────────────────────────────────────────────────
// Reusable seat-map templates (2x2 seater, sofa, sleeper, etc.) so you
// define a layout once and reuse it across many buses.
model SeatLayout {
  id         String   @id @default(cuid())
  name       String
  totalSeats Int
  layoutJson Json // e.g. { rows: [...], seats: [{ number: "A1", type: "window" }, ...] }
  createdAt  DateTime @default(now())

  buses Bus[]
}

model Bus {
  id                String     @id @default(cuid())
  registrationNo    String     @unique
  type              String // e.g. AC Sleeper, Non-AC Seater, VIP Sofa
  brand             String? // e.g. Tata, Ashok Leyland
  model             String? // e.g. Starbus Ultra
  manufacturingYear Int?
  images            String[]   @default([])
  amenities         String[] // e.g. ["wifi", "charging", "blanket"]
  ownerName         String?
  ownerPhone        String?
  insuranceNo       String?
  insuranceExpiry   DateTime?
  fitnessExpiry     DateTime?
  permitExpiry      DateTime?
  rcNumber          String? // Registration Certificate
  seatLayoutId      String
  seatLayout        SeatLayout @relation(fields: [seatLayoutId], references: [id])
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  schedules Schedule[]
  trips     Trip[]
}

// ── Routes & schedules ──────────────────────────────────────
model Route {
  id              String   @id @default(cuid())
  originCity      String
  destinationCity String
  distanceKm      Float?
  durationMinutes Int?
  boardingPoints  String[]
  droppingPoints  String[]
  createdAt       DateTime @default(now())

  schedules Schedule[]

  @@index([originCity, destinationCity])
}

model Schedule {
  id            String   @id @default(cuid())
  routeId       String
  busId         String
  departureTime String // "07:00"
  daysOfWeek    Int[] // 0=Sun..6=Sat; empty array = runs every day
  fare          Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  route     Route      @relation(fields: [routeId], references: [id])
  bus       Bus        @relation(fields: [busId], references: [id])
  trips     Trip[]
  fareTiers FareTier[]
}

// ── Sellable inventory ──────────────────────────────────────
// One concrete departure on one date, generated from a Schedule.
// This is what customers actually search and book.
model Trip {
  id         String   @id @default(cuid())
  scheduleId String
  busId      String
  travelDate DateTime @db.Date
  status     String   @default("SCHEDULED") // SCHEDULED | CANCELLED | DEPARTED
  createdAt  DateTime @default(now())

  schedule Schedule   @relation(fields: [scheduleId], references: [id])
  bus      Bus        @relation(fields: [busId], references: [id])
  seats    TripSeat[]
  bookings Booking[]
  crew     TripCrew[]

  @@unique([scheduleId, travelDate])
  @@index([travelDate])
}

// Per-seat inventory row for a trip. This is the table that prevents
// double-booking — see bookings/seat-lock.service.ts.
model TripSeat {
  id         String     @id @default(cuid())
  tripId     String
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  heldUntil  DateTime? // seat hold expiry during checkout
  bookingId  String?

  trip    Trip     @relation(fields: [tripId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@unique([tripId, seatNumber])
}

// ── Bookings, payments, tickets ─────────────────────────────
model Booking {
  id            String        @id @default(cuid())
  bookingRef    String        @unique // human-facing reference, e.g. BK-2K91X
  siteId        String // which storefront this came through
  tripId        String
  customerName  String
  customerPhone String
  customerEmail String?
  customerId    String? // nullable for backward compatibility or guest checkouts if needed
  totalFare     Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  site       Site        @relation(fields: [siteId], references: [id])
  trip       Trip        @relation(fields: [tripId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  passengers Passenger[]
  seats      TripSeat[]
  payment    Payment?
  ticket     Ticket?

  @@index([siteId])
  @@index([status])
  @@index([customerId])
}

model Passenger {
  id         String  @id @default(cuid())
  bookingId  String
  name       String
  age        Int?
  gender     String?
  seatNumber String

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ── Crew & Personnel ────────────────────────────────────────

enum CrewRole {
  DRIVER
  HELPER
  CONDUCTOR
}

model CrewMember {
  id             String    @id @default(cuid())
  name           String
  phone          String    @unique
  email          String?
  licenseNo      String? // for drivers
  licenseExpiry  DateTime? // track license expiry
  address        String?
  emergencyPhone String?
  role           CrewRole
  photoUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tripAssignments TripCrew[]
}

model TripCrew {
  id           String   @id @default(cuid())
  tripId       String
  crewMemberId String
  role         CrewRole // what role they play on THIS trip

  trip       Trip       @relation(fields: [tripId], references: [id])
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id])

  @@unique([tripId, crewMemberId])
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String        @unique
  gateway      String // e.g. esewa, khalti, stripe
  gatewayTxnId String?       @unique
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(INITIATED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

model Ticket {
  id        String   @id @default(cuid())
  bookingId String   @unique
  qrCode    String
  pdfUrl    String?
  issuedAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ── Advanced Fare Management ────────────────────────────────

model FareTier {
  id            String  @id @default(cuid())
  scheduleId    String
  seatType      String // e.g. "window", "aisle", "sleeper_lower", "sleeper_upper"
  boardingPoint String? // null = all boarding points
  amount        Decimal @db.Decimal(10, 2)

  schedule Schedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, seatType, boardingPoint])
}

model Coupon {
  id               String   @id @default(cuid())
  code             String   @unique
  discountType     String // PERCENTAGE or FLAT
  discountValue    Decimal  @db.Decimal(10, 2)
  maxUses          Int?
  usedCount        Int      @default(0)
  minBookingAmount Decimal? @db.Decimal(10, 2)
  validFrom        DateTime
  validTo          DateTime
  isActive         Boolean  @default(true)
  siteId           String? // null = global coupon across all sites
  createdAt        DateTime @default(now())
}

// ── Customers & CRM ─────────────────────────────────────────

model Customer {
  id         String    @id @default(cuid())
  name       String
  phone      String    @unique
  email      String?
  city       String?
  tags       String[]
  budgetTier String?
  leadScore  Int       @default(0)
  bookings   Booking[]
  createdAt  DateTime  @default(now())
}

model CancellationPolicy {
  id             String   @id @default(cuid())
  hoursBeforeDep Int // e.g. 24 = "if cancelled 24+ hours before departure"
  refundPercent  Int // e.g. 80 = "refund 80% of fare"
  createdAt      DateTime @default(now())
}

// ── Content Management System (CMS) ─────────────────────────

model Slider {
  id        String   @id @default(cuid())
  siteId    String? // null = global slider
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Blog {
  id          String   @id @default(cuid())
  siteId      String?
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   @db.Text
  coverImage  String?
  author      String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  siteId    String?
  name      String
  role      String?
  content   String   @db.Text
  rating    Int      @default(5)
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TeamMember {
  id       String  @id @default(cuid())
  siteId   String?
  name     String
  role     String
  bio      String? @db.Text
  imageUrl String?
  order    Int     @default(0)
  isActive Boolean @default(true)
}

model FAQ {
  id       String  @id @default(cuid())
  siteId   String?
  question String
  answer   String  @db.Text
  order    Int     @default(0)
  isActive Boolean @default(true)
}

model GalleryImage {
  id        String   @id @default(cuid())
  siteId    String?
  title     String?
  imageUrl  String
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id          String   @id @default(cuid())
  siteId      String?  @unique // null = global default
  aboutUsText String?  @db.Text
  contactInfo Json? // { phone, email, address, facebookUrl, ... }
  termsText   String?  @db.Text
  privacyText String?  @db.Text
  updatedAt   DateTime @updatedAt
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  subject        String
  preheader      String?
  htmlContent    String         @db.Text
  targetFilter   Json?
  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// ═══════════════════════════════════════════════════════════
// CMS — GLOBAL SITE SETTINGS (SEO & Config)
// ═══════════════════════════════════════════════════════════

model SiteSettings {
  id              String   @id @default("global")
  businessName    String?
  telephone       String?
  email           String?
  streetAddress   String?
  locality        String?
  region          String?
  postalCode      String?
  country         String   @default("NP")
  facebookUrl     String?
  instagramUrl    String?
  twitterUrl      String?
  defaultOgImage  String?
  metaTitle       String?
  metaDescription String?  @db.Text
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// CMS — BUS SERVICES (Homepage cards)
// ═══════════════════════════════════════════════════════════

model BusService {
  id            String   @id @default(cuid())
  title         String
  slug          String?  @unique
  source        String
  destination   String
  departureTime String?
  arrivalTime   String?
  price         Float
  duration      String?
  busType       String   @default("standard")
  amenities     String[]
  description   String?  @db.Text
  gallery       String[]
  metaTitle     String?
  metaDescription String? @db.Text
  faqs          Json?
  image         String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([source, destination])
}

// ═══════════════════════════════════════════════════════════
// CMS — TOUR PACKAGES
// ═══════════════════════════════════════════════════════════

model TourPackage {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?
  price            Float
  duration         String
  image            String?
  itinerary        Json?
  includedServices String[]
  excludedServices String[]
  highlights       String[]
  galleryImages    String[]
  faqs             Json?
  difficulty       String?
  maxGroupSize     Int?
  startLocation    String?
  endLocation      String?
  featured         Boolean  @default(false)
  status           String   @default("active")
  seoTitle         String?
  seoDescription   String?  @db.Text
  seoKeywords      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([slug])
}

// ═══════════════════════════════════════════════════════════
// CMS — VEHICLE RENTALS
// ═══════════════════════════════════════════════════════════

model VehicleRental {
  id                 String   @id @default(cuid())
  vehicleName        String
  slug               String   @unique
  vehicleType        String
  pricePerDay        Float
  capacity           Int
  transmission       String   @default("automatic")
  fuelType           String   @default("petrol")
  description        String?
  about              String?  @db.Text
  faqs               Json?
  features           String[]
  images             String[]
  availabilityStatus String   @default("available")
  isFeatured         Boolean  @default(false)
  seoTitle           String?
  seoKeywords        String?
  seoDescription     String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([availabilityStatus])
  @@index([vehicleType])
  @@index([isFeatured])
  @@index([slug])
}

// ═══════════════════════════════════════════════════════════
// CMS — ABOUT US (Singleton)
// ═══════════════════════════════════════════════════════════

model AboutUs {
  id           String   @id @default(cuid())
  companyStory String?
  mission      String?
  vision       String?
  achievements String[]
  teamMembers  Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// CMS — BRANCH LOCATIONS
// ═══════════════════════════════════════════════════════════

model BranchLocation {
  id              String   @id @default(cuid())
  branchName      String
  address         String
  phone           String?
  email           String?
  googleMapEmbedUrl String?
  workingHours    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// CMS — HERO BANNERS
// ═══════════════════════════════════════════════════════════

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  videoUrl  String?
  ctaText   String?
  ctaLink   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ═══════════════════════════════════════════════════════════
// CMS — CONTACT INFO (Singleton)
// ═══════════════════════════════════════════════════════════

model ContactInfo {
  id           String   @id @default(cuid())
  phone        String?
  email        String?
  address      String?
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  whatsapp     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// CMS — BLOG AUTHORS
// ═══════════════════════════════════════════════════════════

model BlogAuthor {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  bio       String?
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// CMS — ACHIEVEMENTS
// ═══════════════════════════════════════════════════════════

model Achievement {
  id           String   @id @default(cuid())
  name         String
  totalCount   Int      @default(0)
  icon         String?
  displayOrder Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// ═══════════════════════════════════════════════════════════
// CMS — FEATURES
// ═══════════════════════════════════════════════════════════

model Feature {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  image        String?
  metaLink     String?
  description  String?
  displayOrder Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([slug])
}

// ═══════════════════════════════════════════════════════════
// CMS — EMAIL SUBSCRIBERS (Travel Marketing Hub)
// ═══════════════════════════════════════════════════════════

model EmailSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  city         String?
  budgetTier   String?
  leadScore    Int      @default(0)
  source       String?
  status       String   @default("active")
  metadata     Json     @default("{}")
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tags        SubscriberTag[]
  events      SubscriberEvent[]
  automations AutomationEnrollment[]

  @@index([leadScore])
  @@index([city])
  @@index([status])
  @@index([source])
}

model SubscriberTag {
  id           String   @id @default(cuid())
  category     String
  value        String
  createdAt    DateTime @default(now())

  subscriberId String
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, category, value])
  @@index([subscriberId])
  @@index([category, value])
}

model SubscriberEvent {
  id         String   @id @default(cuid())
  eventType  String
  eventData  Json     @default("{}")
  campaignId String?
  createdAt  DateTime @default(now())

  subscriberId String
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([eventType])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// CMS — BOOKING INQUIRIES
// ═══════════════════════════════════════════════════════════

model BookingInquiry {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String
  packageName   String?
  departureDate DateTime?
  arrivalDate   DateTime?
  message       String?
  seen          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([seen])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// CMS — PARTNER REQUESTS
// ═══════════════════════════════════════════════════════════

model PartnerRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// CMS — CONTACT SUBMISSIONS
// ═══════════════════════════════════════════════════════════

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([seen])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// CMS — NEPAL DESTINATIONS
// ═══════════════════════════════════════════════════════════

model Destination {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  subtitle       String?
  description    String?  @db.Text
  image          String?
  imageAlt       String?
  highlights     String[]
  seoTitle       String?
  seoDescription String?  @db.Text
  seoKeywords    String?
  displayOrder   Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
}

// ═══════════════════════════════════════════════════════════
// CMS — STORIES (Instagram-style circles)
// ═══════════════════════════════════════════════════════════

model Story {
  id           String   @id @default(cuid())
  name         String
  avatar       String?
  mediaItems   Json     @default("[]")
  displayOrder Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
}

// ═══════════════════════════════════════════════════════════
// PAYMENTS — NRT (eSewa, Khalti, Cash on Bus, PACO)
// ═══════════════════════════════════════════════════════════

model NrtPayment {
  id              String   @id @default(cuid())
  ticketNo        String
  method          String
  amount          Float
  currency        String   @default("NPR")
  status          String   @default("pending")
  transactionId   String?
  gatewayResponse Json?
  passengerName   String?
  passengerPhone  String?
  passengerEmail  String?
  route           String?
  travelDate      String?
  seatNumbers     String[]
  discountAmount  Float?   @default(0)
  couponCode      String?
  isFinalized     Boolean  @default(false)
  retryCount      Int      @default(0)
  lastError       String?
  finalizedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ticketNo])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// SUPPORT TICKETS (AI Chatbot raised)
// ═══════════════════════════════════════════════════════════

model SupportTicket {
  id              String   @id @default(cuid())
  ticketNo        String
  type            String   @default("cancellation")
  reason          String?
  status          String   @default("pending")
  passengerName   String?
  passengerPhone  String?
  passengerEmail  String?
  route           String?
  travelDate      String?
  seatNumbers     String[]
  amount          Float?
  adminNotes      String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ticketNo])
  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// CMS — ADVENTURE ACTIVITIES
// ═══════════════════════════════════════════════════════════

model AdventureActivity {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  content      String?  @db.Text
  image        String?
  price        String?
  duration     String?
  detailsTable Json?
  displayOrder Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
  @@index([slug])
}

// ═══════════════════════════════════════════════════════════
// CMS — AUTOMATION ENGINE
// ═══════════════════════════════════════════════════════════

model AutomationWorkflow {
  id            String   @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean  @default(false)
  triggerType   String
  triggerConfig Json     @default("{}")
  conditions    Json     @default("{}")
  actions       Json     @default("[]")
  enrollCount   Int      @default(0)
  completeCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments AutomationEnrollment[]

  @@index([isActive])
}

model AutomationEnrollment {
  id            String    @id @default(cuid())
  workflowId    String
  subscriberId  String
  status        String
  enrolledAt    DateTime  @default(now())
  completedAt   DateTime?
  logs          Json      @default("[]")

  workflow      AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  subscriber    EmailSubscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([workflowId, subscriberId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
// CMS — DYNAMIC CONTENT TYPES
// ═══════════════════════════════════════════════════════════

model ContentType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  fields      Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries ContentEntry[]
}

model ContentEntry {
  id        String    @id @default(cuid())
  data      Json
  slug      String?
  status    String    @default("draft")
  version   Int       @default(1)
  publishedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  versions ContentVersion[]

  @@index([contentTypeId])
  @@index([slug])
  @@index([status])
}

model ContentVersion {
  id        String   @id @default(cuid())
  data      Json
  version   Int
  createdAt DateTime @default(now())

  entryId String
  entry   ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

// ═══════════════════════════════════════════════════════════
// CMS — PAGES (Block-based Page Builder)
// ═══════════════════════════════════════════════════════════

model CmsPage {
  id          String    @id @default(cuid())
  title       String
  slug        String
  content     String?   @db.Text
  blocks      Json      @default("[]")
  status      String    @default("published")
  tenantId    String?
  seoTitle    String?
  seoDesc     String?
  seoDescription String?
  seoKeywords String?
  template    String    @default("default")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug, tenantId])
  @@index([status])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════
// MEDIA LIBRARY
// ═══════════════════════════════════════════════════════════

model MediaFile {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  alt       String?
  folder    String   @default("/")
  createdAt DateTime @default(now())

  @@index([folder])
}

// ═══════════════════════════════════════════════════════════
// PLUGINS
// ═══════════════════════════════════════════════════════════

model Plugin {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  version     String
  description String?
  enabled     Boolean  @default(false)
  config      Json     @default("{}")
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
