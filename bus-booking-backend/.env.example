# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/bus_booking?schema=public"

# Redis connection (seat holds, caching)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# Seat hold duration in minutes
SEAT_HOLD_MINUTES=8

# Payment gateways — add whichever you're integrating
STRIPE_SECRET_KEY=""
ESEWA_MERCHANT_CODE=""
KHALTI_SECRET_KEY=""

# Notifications
SMS_API_KEY=""
WHATSAPP_API_TOKEN=""
EMAIL_FROM="tickets@yourbrand.com"
SENDGRID_API_KEY=""
